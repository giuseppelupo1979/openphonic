<Window x:Class="OpenPhonic.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OpenPhonic.UI"
        Title="OpenPhonic" Width="1320" Height="880" MinWidth="1100" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#09090F"
        Icon="pack://application:,,,/Assets/OpenPhonic.png"
        AllowDrop="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type ui:HomeScreen}"><ui:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type ui:SetupScreen}"><ui:SetupView /></DataTemplate>
        <DataTemplate DataType="{x:Type ui:ProcessingScreen}"><ui:ProcessingView /></DataTemplate>
        <DataTemplate DataType="{x:Type ui:ResultScreen}"><ui:ResultView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <ui:AuroraBackground />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Margin="14,14,0,14" CornerRadius="26" Background="#59000000"
                    BorderBrush="#12FFFFFF" BorderThickness="1" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,18">
                            <Image Source="pack://application:,,,/Assets/OpenPhonic.png" Width="42" Height="42"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OpenPhonic" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="Studio audio automatico" FontSize="11" Foreground="{StaticResource Text2}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource GlowButtonSmall}" Click="OnNew" HorizontalAlignment="Stretch" AutomationProperties.Name="Nuova produzione">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Nuova produzione" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <DockPanel Margin="0,22,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Click="OnStartAll">
                                <TextBlock Text="Elabora tutte" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ember}" />
                            </Button>
                            <TextBlock Text="PRODUZIONI" Style="{StaticResource Caption}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- engine status + output folder -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <!-- new version banner -->
                        <Border CornerRadius="16" Padding="14" Margin="0,0,0,14" BorderThickness="1"
                                BorderBrush="{StaticResource Accent}" Background="#1FFF3D8C"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Foreground="{StaticResource Rose}" Margin="0,0,8,0" />
                                    <TextBlock FontSize="13" FontWeight="Bold">
                                        <Run Text="Nuova versione " /><Run Text="{Binding Update.Version, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Update.Notes}" FontSize="11" Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                                           MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="0,6,0,10" />
                                <Button Style="{StaticResource GlowButtonSmall}" Click="OnUpdate" IsEnabled="{Binding UpdateBusy, Converter={StaticResource Not}}"
                                        AutomationProperties.Name="Aggiorna">
                                    <TextBlock Text="Aggiorna e riavvia" Foreground="White" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Visibility="{Binding UpdateStatus, Converter={StaticResource Shown}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Mint}" Margin="0,0,8,0" />
                            <TextBlock Text="ffmpeg" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="FfStatus" Text=" pronto" FontSize="11" Foreground="{StaticResource Text3}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Mint}" Margin="0,0,8,0" />
                            <TextBlock Text="Riduzione rumore AI" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="DfStatus" Text=" DeepFilterNet" FontSize="11" Foreground="{StaticResource Text3}" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Click="OnCheckUpdate"
                                    AutomationProperties.Name="Controlla aggiornamenti">
                                <TextBlock Text="Controlla aggiornamenti" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ember}" />
                            </Button>
                            <TextBlock FontSize="11" Foreground="{StaticResource Text3}">
                                <Run Text="Versione " /><Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <Button Style="{StaticResource PlainButton}" Click="OnFolder" ToolTip="{Binding OutputFolder}">
                            <Border Background="#0FFFFFFF" CornerRadius="10" Padding="10,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10"
                                               Foreground="{StaticResource Text3}" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Foreground="{StaticResource Ember}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding OutputFolderName}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </Button>
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="List" ItemsSource="{Binding Productions}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnPick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="B" CornerRadius="14" Padding="10" Margin="0,0,0,6" Background="Transparent"
                                                        BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#0FFFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#33FF3D8C" />
                                                        <Setter TargetName="B" Property="BorderBrush" Value="#99FF3D8C" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:Production}">
                                    <DockPanel>
                                        <Grid Width="34" Height="34" Margin="0,0,12,0">
                                            <Ellipse Fill="#12FFFFFF" />
                                            <ui:ProgressRing Value="{Binding Progress}" Status="{Binding Status}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Text2}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Mostra in Esplora file" Click="OnReveal" />
                                                <Separator />
                                                <MenuItem Header="Rimuovi dall'elenco" Click="OnRemove" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                    x:Name="EmptyHint">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="28" Foreground="{StaticResource Text3}" />
                            <TextBlock Text="Le tue produzioni&#x0a;appariranno qui" TextAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource Text3}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- main area -->
            <ContentControl Grid.Column="1" x:Name="Main" Content="{Binding Screen}" Focusable="False" />

            <!-- caption buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Click="OnMin"><TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10" /></Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMax"><TextBlock Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10" /></Button>
                <Button Style="{StaticResource CloseButton}" Click="OnClose"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10" /></Button>
            </StackPanel>
        </Grid>

        <!-- drop overlay -->
        <Border x:Name="DropOverlay" Background="#B309090F" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource Accent}" BorderThickness="3" CornerRadius="32" Margin="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:LiveBars Height="80" Width="240" Intense="True" />
                    <TextBlock Text="Rilascia per iniziare" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
