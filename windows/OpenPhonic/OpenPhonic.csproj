<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OpenPhonic</AssemblyName>
    <RootNamespace>OpenPhonic</RootNamespace>
    <ApplicationIcon>Assets\OpenPhonic.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>OpenPhonic</Product>
    <Company>Giuseppe Lupo</Company>
    <Description>Post-produzione audio automatica</Description>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OpenPhonic.png" />
    <!-- ffmpeg, ffprobe, DeepFilterNet and the RNNoise model, fetched by tools\build.ps1 -->
    <None Include="..\third_party\$(RuntimeIdentifier)\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' != ''" />
  </ItemGroup>

</Project>
