<UserControl x:Class="OpenPhonic.UI.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OpenPhonic.UI">
    <UserControl.Resources>
        <Style TargetType="ui:AlgoCard">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:AlgoCard">
                        <Border x:Name="Card" Style="{StaticResource Glass}">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                                  IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="{TemplateBinding HasSwitch, Converter={StaticResource BoolToVis}}" />
                                    <Border x:Name="Badge" Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentDiagonal}"
                                            Margin="0,0,12,0" VerticalAlignment="Top" Effect="{StaticResource RoseGlowSoft}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Glyph}" FontSize="17" />
                                    </Border>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{TemplateBinding Header}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12" Foreground="{StaticResource Text2}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ContentPresenter x:Name="BodyPart" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsOn" Value="False">
                                <Setter TargetName="BodyPart" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Card" Property="Opacity" Value="0.7" />
                                <Setter TargetName="Badge" Property="Background" Value="#17FFFFFF" />
                                <Setter TargetName="Badge" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="Width" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Opt" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,44,34,120">
                <!-- header -->
                <DockPanel Margin="0,0,0,18">
                    <Border Width="64" Height="64" CornerRadius="18" Background="#0FFFFFFF" Margin="0,0,18,0">
                        <TextBlock x:Name="KindGlyph" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="26" Foreground="{StaticResource Rose}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding P.Name}" FontSize="28" FontWeight="Heavy" TextTrimming="CharacterEllipsis" />
                        <WrapPanel x:Name="InfoChips" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>

                <Border x:Name="ErrorBox" Style="{StaticResource Glass}" Padding="14" Margin="0,0,0,18"
                        Visibility="{Binding P.Error, Converter={StaticResource Shown}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="Gold" FontSize="16" Margin="0,0,10,0" />
                        <TextBox Text="{Binding P.Error, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="White" TextWrapping="Wrap" FontSize="13" />
                    </DockPanel>
                </Border>

                <WrapPanel x:Name="PresetBar" Margin="0,0,0,20" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ui:AlgoCard Glyph="&#xE945;" Header="Riduzione rumore"
                                     Subtitle="Rete neurale che separa la voce da rumore, ventole e riverbero"
                                     IsOn="{Binding P.Settings.DenoiseOn}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Metodo" Style="{StaticResource RowLabel}" />
                                    <Border Style="{StaticResource ChipBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="dm" Content="AI" IsChecked="{Binding P.Settings.DenoiseMethod, Converter={StaticResource Eq}, ConverterParameter=Ai}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="dm" Content="RNNoise" IsChecked="{Binding P.Settings.DenoiseMethod, Converter={StaticResource Eq}, ConverterParameter=Rnnoise}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="dm" Content="Classico (leggero)" IsChecked="{Binding P.Settings.DenoiseMethod, Converter={StaticResource Eq}, ConverterParameter=Classic}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Quantità" Style="{StaticResource RowLabel}" />
                                    <Border Style="{StaticResource ChipBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="da" Content="Auto" IsChecked="{Binding P.Settings.DenoiseAmount, Converter={StaticResource Eq}, ConverterParameter=Auto}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="da" Content="Bassa" IsChecked="{Binding P.Settings.DenoiseAmount, Converter={StaticResource Eq}, ConverterParameter=Low}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="da" Content="Media" IsChecked="{Binding P.Settings.DenoiseAmount, Converter={StaticResource Eq}, ConverterParameter=Medium}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="da" Content="Alta" IsChecked="{Binding P.Settings.DenoiseAmount, Converter={StaticResource Eq}, ConverterParameter=High}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="da" Content="Max" IsChecked="{Binding P.Settings.DenoiseAmount, Converter={StaticResource Eq}, ConverterParameter=Max}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </ui:AlgoCard>

                        <ui:AlgoCard Glyph="&#xE9E9;" Header="Filtri e Voice AutoEQ"
                                     Subtitle="Rombi, ronzio elettrico, timbro, sibilanti e plosive"
                                     IsOn="{Binding P.Settings.FilterOn}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Passa-alto" Style="{StaticResource RowLabel}" />
                                    <Border Style="{StaticResource ChipBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="hp" Content="Off" IsChecked="{Binding P.Settings.Highpass, Converter={StaticResource Eq}, ConverterParameter=0}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="hp" Content="60 Hz" IsChecked="{Binding P.Settings.Highpass, Converter={StaticResource Eq}, ConverterParameter=60}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="hp" Content="75 Hz" IsChecked="{Binding P.Settings.Highpass, Converter={StaticResource Eq}, ConverterParameter=75}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="hp" Content="100 Hz" IsChecked="{Binding P.Settings.Highpass, Converter={StaticResource Eq}, ConverterParameter=100}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="hp" Content="120 Hz" IsChecked="{Binding P.Settings.Highpass, Converter={StaticResource Eq}, ConverterParameter=120}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <ToggleButton Style="{StaticResource Opt}" IsChecked="{Binding P.Settings.HumAuto}"><TextBlock Text="Ronzio 50/60 Hz automatico" FontSize="13" /></ToggleButton>
                                <ToggleButton Style="{StaticResource Opt}" IsChecked="{Binding P.Settings.AutoEQ}"><TextBlock Text="Voice AutoEQ" FontSize="13" /></ToggleButton>
                                <ToggleButton Style="{StaticResource Opt}" IsChecked="{Binding P.Settings.Deesser}"><TextBlock Text="De-esser (sibilanti)" FontSize="13" /></ToggleButton>
                                <ToggleButton Style="{StaticResource Opt}" IsChecked="{Binding P.Settings.Deplosive}"><TextBlock Text="De-plosive (P e B)" FontSize="13" /></ToggleButton>
                            </StackPanel>
                        </ui:AlgoCard>

                        <ui:AlgoCard Glyph="&#xE8C6;" Header="Taglio pause"
                                     Subtitle="Accorcia i silenzi lunghi, con dissolvenze invisibili"
                                     IsOn="{Binding P.Settings.CutSilence}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Pause oltre" Style="{StaticResource RowLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding P.Settings.MinSilence, StringFormat={}{0:0.0} s}" VerticalAlignment="Center" />
                                    <Slider Style="{StaticResource GlowSlider}" Minimum="0.4" Maximum="4" TickFrequency="0.1"
                                            Value="{Binding P.Settings.MinSilence}" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Lascia" Style="{StaticResource RowLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding P.Settings.KeepSilence, StringFormat={}{0:0.00} s}" VerticalAlignment="Center" />
                                    <Slider Style="{StaticResource GlowSlider}" Minimum="0" Maximum="1.5" TickFrequency="0.05"
                                            Value="{Binding P.Settings.KeepSilence}" Margin="0,0,12,0" />
                                </DockPanel>
                                <ToggleButton Style="{StaticResource Opt}" IsChecked="{Binding P.Settings.CutFillers}"><TextBlock Text="Taglia anche ehm, uhm, mh" FontSize="13" /></ToggleButton>
                            </StackPanel>
                        </ui:AlgoCard>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <ui:AlgoCard Glyph="&#xE9D2;" Header="Adaptive Leveler"
                                     Subtitle="Bilancia frase per frase, senza alzare il rumore nelle pause"
                                     IsOn="{Binding P.Settings.LevelerOn}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Intensità" Style="{StaticResource RowLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding P.Settings.LevelerStrength, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                                    <Slider Style="{StaticResource GlowSlider}" Minimum="0" Maximum="100" TickFrequency="10"
                                            Value="{Binding P.Settings.LevelerStrength}" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Compressore" Style="{StaticResource RowLabel}" />
                                    <Border Style="{StaticResource ChipBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="co" Content="Auto" IsChecked="{Binding P.Settings.Compressor, Converter={StaticResource Eq}, ConverterParameter=Auto}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="co" Content="Leggero" IsChecked="{Binding P.Settings.Compressor, Converter={StaticResource Eq}, ConverterParameter=Soft}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="co" Content="Medio" IsChecked="{Binding P.Settings.Compressor, Converter={StaticResource Eq}, ConverterParameter=Medium}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="co" Content="Forte" IsChecked="{Binding P.Settings.Compressor, Converter={StaticResource Eq}, ConverterParameter=Hard}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="co" Content="Off" IsChecked="{Binding P.Settings.Compressor, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </ui:AlgoCard>

                        <ui:AlgoCard Glyph="&#xEC4A;" Header="Loudness"
                                     Subtitle="EBU R128 con limitatore true peak, precisione 0,2 LU"
                                     IsOn="{Binding P.Settings.LoudnessOn}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Target" Style="{StaticResource RowLabel}" />
                                    <Border Style="{StaticResource ChipBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="lt" Content="−23" IsChecked="{Binding P.Settings.LoudnessTarget, Converter={StaticResource Eq}, ConverterParameter=-23}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="lt" Content="−19" IsChecked="{Binding P.Settings.LoudnessTarget, Converter={StaticResource Eq}, ConverterParameter=-19}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="lt" Content="−18" IsChecked="{Binding P.Settings.LoudnessTarget, Converter={StaticResource Eq}, ConverterParameter=-18}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="lt" Content="−16" IsChecked="{Binding P.Settings.LoudnessTarget, Converter={StaticResource Eq}, ConverterParameter=-16}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="lt" Content="−14" IsChecked="{Binding P.Settings.LoudnessTarget, Converter={StaticResource Eq}, ConverterParameter=-14}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <TextBlock x:Name="TargetHint" FontSize="12" Foreground="{StaticResource Text3}" Margin="96,-4,0,10" />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="True peak" Style="{StaticResource RowLabel}" />
                                    <Border Style="{StaticResource ChipBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="tp" Content="−1 dB" IsChecked="{Binding P.Settings.TruePeak, Converter={StaticResource Eq}, ConverterParameter=-1}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="tp" Content="−1,5" IsChecked="{Binding P.Settings.TruePeak, Converter={StaticResource Eq}, ConverterParameter=-1.5}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="tp" Content="−2" IsChecked="{Binding P.Settings.TruePeak, Converter={StaticResource Eq}, ConverterParameter=-2}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="tp" Content="−3" IsChecked="{Binding P.Settings.TruePeak, Converter={StaticResource Eq}, ConverterParameter=-3}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </ui:AlgoCard>

                        <ui:AlgoCard Glyph="&#xED1E;" Header="Trascrizione"
                                     Subtitle="Whisper sul tuo PC: testo e sottotitoli SRT, VTT (modello scaricato al primo uso)"
                                     IsOn="{Binding P.Settings.Transcribe}">
                            <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Modello" Style="{StaticResource RowLabel}" />
                                <Border Style="{StaticResource ChipBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="wm" Content="Veloce" IsChecked="{Binding P.Settings.WhisperModel, Converter={StaticResource Eq}, ConverterParameter=base}" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="wm" Content="Accurato" IsChecked="{Binding P.Settings.WhisperModel, Converter={StaticResource Eq}, ConverterParameter=small}" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="wm" Content="Massima qualità" IsChecked="{Binding P.Settings.WhisperModel, Converter={StaticResource Eq}, ConverterParameter=medium}" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Lingua" Style="{StaticResource RowLabel}" />
                                <Border Style="{StaticResource ChipBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="lg" Content="Italiano" IsChecked="{Binding P.Settings.Language, Converter={StaticResource Eq}, ConverterParameter=it}" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="lg" Content="Inglese" IsChecked="{Binding P.Settings.Language, Converter={StaticResource Eq}, ConverterParameter=en}" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="lg" Content="Spagnolo" IsChecked="{Binding P.Settings.Language, Converter={StaticResource Eq}, ConverterParameter=es}" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="lg" Content="Francese" IsChecked="{Binding P.Settings.Language, Converter={StaticResource Eq}, ConverterParameter=fr}" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="lg" Content="Tedesco" IsChecked="{Binding P.Settings.Language, Converter={StaticResource Eq}, ConverterParameter=de}" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            </StackPanel>
                        </ui:AlgoCard>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ui:AlgoCard Grid.Column="0" Glyph="&#xE896;" Header="File in uscita" Subtitle="Formati, qualità e canali" HasSwitch="False">
                        <StackPanel>
                            <ItemsControl x:Name="OutputsList" />
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnAddOutput" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Aggiungi formato" Foreground="White" />
                                </StackPanel>
                                <Button.ContextMenu><ContextMenu x:Name="FormatMenu" /></Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </ui:AlgoCard>
                    <ui:AlgoCard Grid.Column="2" Glyph="&#xE8EC;" Header="Metadati ed extra" Subtitle="Titolo, autore, intro, outro, copertina" HasSwitch="False">
                        <StackPanel>
                            <TextBox Style="{StaticResource GlassBox}" Tag="Titolo" Margin="0,0,0,8" TextChanged="OnTitle"
                                     Text="{Binding P.Settings.Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource GlassBox}" Tag="Autore" Margin="0,0,0,8"
                                     Text="{Binding P.Settings.Artist, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource GlassBox}" Tag="Album o podcast" Margin="0,0,0,12"
                                     Text="{Binding P.Settings.Album, UpdateSourceTrigger=PropertyChanged}" />
                            <UniformGrid Columns="3">
                                <Button x:Name="IntroBtn" Style="{StaticResource PlainButton}" Tag="Intro" Click="OnExtra" Margin="0,0,8,0" />
                                <Button x:Name="OutroBtn" Style="{StaticResource PlainButton}" Tag="Outro" Click="OnExtra" Margin="0,0,8,0" />
                                <Button x:Name="CoverBtn" Style="{StaticResource PlainButton}" Tag="Cover" Click="OnExtra" />
                            </UniformGrid>
                        </StackPanel>
                    </ui:AlgoCard>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- action bar -->
        <Border VerticalAlignment="Bottom" Margin="34,0,34,22" CornerRadius="34" Background="#D9101018"
                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="22,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GlowButton}" Click="OnStart" AutomationProperties.Name="Elabora">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Elabora" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pronto per l'elaborazione" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="Summary" FontSize="12" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
