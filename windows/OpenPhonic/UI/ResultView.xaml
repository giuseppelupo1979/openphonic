<UserControl x:Class="OpenPhonic.UI.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OpenPhonic.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,44,34,40">
            <!-- header -->
            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Style="{StaticResource GlowButtonSmall}" Click="OnReveal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Mostra in Esplora file" Foreground="White" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnReprocess" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Modifica e rielabora" Foreground="White" />
                    </StackPanel>
                </Button>
                <Grid Width="56" Height="56" Margin="0,0,16,0" x:Name="Check" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="0.4" ScaleY="0.4" /></Grid.RenderTransform>
                    <Ellipse Fill="{StaticResource AccentDiagonal}" Effect="{StaticResource RoseGlow}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="24" FontWeight="Bold" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding P.Name}" FontSize="30" FontWeight="Heavy" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeaderSub" FontSize="13" Foreground="{StaticResource Text2}" />
                </StackPanel>
            </DockPanel>

            <!-- player -->
            <Border Style="{StaticResource Glass}" CornerRadius="26" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="7" Height="7" Fill="#8CFFFFFF" Margin="0,0,6,0" />
                        <TextBlock Text="PRIMA" Style="{StaticResource Caption}" Foreground="{StaticResource Text2}" />
                    </StackPanel>
                    <ui:Waveform x:Name="WaveBefore" Height="74" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,6,0" />
                        <TextBlock Text="DOPO" Style="{StaticResource Caption}" Foreground="{StaticResource Text2}" />
                    </StackPanel>
                    <ui:Waveform x:Name="WaveAfter" Height="74" Glow="True" />
                    <DockPanel Margin="0,16,0,0">
                        <Button x:Name="PlayBtn" Style="{StaticResource PlainButton}" Click="OnPlay" Margin="0,0,18,0" AutomationProperties.Name="Riproduci">
                            <Grid Width="58" Height="58">
                                <Ellipse Fill="{StaticResource AccentDiagonal}" Effect="{StaticResource RoseGlow}" />
                                <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="22" />
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource ChipBar}" VerticalAlignment="Center" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SideBefore" Style="{StaticResource Chip}" GroupName="ab" Content="Prima" FontSize="13" Checked="OnSide" />
                                <RadioButton x:Name="SideAfter" Style="{StaticResource Chip}" GroupName="ab" Content="Dopo" FontSize="13" IsChecked="True" Checked="OnSide" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="Time" FontSize="14" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                        <TextBlock Text="Spazio per play/pausa · clic sulle onde per saltare" FontSize="11" Foreground="{StaticResource Text3}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- stats -->
            <UniformGrid x:Name="Stats" Columns="5" Margin="0,0,0,18" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Text="trascina per confrontare" FontSize="11" Foreground="{StaticResource Text3}" VerticalAlignment="Center" />
                                <TextBlock Text="Spettrogramma" FontSize="17" FontWeight="Bold" />
                            </DockPanel>
                            <Grid x:Name="Spec" Cursor="SizeWE" Background="Black" ClipToBounds="True">
                                <Grid.Clip><RectangleGeometry x:Name="SpecRound" RadiusX="14" RadiusY="14" /></Grid.Clip>
                                <Image x:Name="SpecAfter" Stretch="Fill" />
                                <Image x:Name="SpecBefore" Stretch="Fill">
                                    <Image.Clip><RectangleGeometry x:Name="SpecClip" /></Image.Clip>
                                </Image>
                                <Canvas>
                                    <Rectangle x:Name="SpecLine" Width="2" Fill="White">
                                        <Rectangle.Effect><DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" /></Rectangle.Effect>
                                    </Rectangle>
                                    <Grid x:Name="SpecHandle" Width="26" Height="26">
                                        <Ellipse Fill="White" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="11" Foreground="Black" />
                                    </Grid>
                                </Canvas>
                                <Border Background="#8C000000" CornerRadius="9" Padding="8,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="PRIMA" FontSize="10" FontWeight="Heavy" />
                                </Border>
                                <Border Background="#8C000000" CornerRadius="9" Padding="8,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="DOPO" FontSize="10" FontWeight="Heavy" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TranscriptCard" Style="{StaticResource Glass}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Trascrizione" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Transcript" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="File pronti" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                            <StackPanel x:Name="Files" />
                            <TextBlock Text="Trascina un file direttamente in un'altra app" FontSize="11" Foreground="{StaticResource Text3}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Glass}">
                        <StackPanel>
                            <TextBlock Text="Cosa è stato fatto" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                            <StackPanel x:Name="Notes" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
